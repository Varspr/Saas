# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ─────────────────────────────────────────────────────────────
# Database (PostgreSQL) — Фаза 0
# ─────────────────────────────────────────────────────────────
# В docker-compose хост = "db". Локально без compose = "localhost".
DATABASE_URL=postgresql+psycopg://tryon:tryon@db:5432/tryon

# ─────────────────────────────────────────────────────────────
# Redis / Celery — Фаза 0
# ─────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─────────────────────────────────────────────────────────────
# Storage — Фаза 0 / Фаза 4
# use_local_storage=true → файлы пишутся в LOCAL_STORAGE_DIR (dev).
# Для прода: USE_LOCAL_STORAGE=false и заполнить S3/R2 ниже.
# ─────────────────────────────────────────────────────────────
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=/data/storage

# Cloudflare R2 пример:
# USE_LOCAL_STORAGE=false
# S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=tryon
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://cdn.example.com   # если бакет публичный/за CDN

# ─────────────────────────────────────────────────────────────
# Pipeline — Фазы 1-4
# MOCK_PIPELINE=true  → CPU-заглушки, без GPU (dev).
# MOCK_PIPELINE=false → реальные SAM + InstantMesh + Blender (GPU).
# ─────────────────────────────────────────────────────────────
MOCK_PIPELINE=true

# Реальные модели (нужны только при MOCK_PIPELINE=false):
SAM_CHECKPOINT=/models/sam_vit_h_4b8939.pth
SAM_MODEL_TYPE=vit_h
INSTANTMESH_REPO=/opt/InstantMesh
INSTANTMESH_CONFIG=/opt/InstantMesh/configs/instant-mesh-large.yaml
BLENDER_BIN=blender
BODY_MESH_PATH=/assets/body_tpose.obj

# ── Тело и физика одежды (Фаза 3) ──
# Метод примерки: auto | mock | blender
#   auto    — физика ткани в Blender, если он установлен, иначе статичная посадка
#   mock    — статичная облегающая одежда (быстро, без Blender)
#   blender — всегда cloth simulation (нужен установленный Blender; работает на CPU)
# ВАЖНО: физика ткани НЕ требует GPU. Чтобы включить её в обычном (CPU) воркере —
# поставьте Blender в образ и задайте DRAPE_BACKEND=blender.
DRAPE_BACKEND=auto

# Движок тела:
#   parametric — trimesh-манекен из сечений (без Blender, стилизованный) — дефолт
#   mpfb       — реалистичный манекен MakeHuman/MPFB2 (как на витрине). Требует
#                Blender с установленным MPFB2 (см. MANNEQUIN.md). Меши CC0.
#   smplx      — SMPL-X (нужна коммерческая лицензия; scaffold)
BODY_ENGINE=parametric
BODY_GENDER=male

# SMPL-X (scaffold). false → используется BODY_ENGINE выше.
USE_SMPLX=false
SMPLX_MODEL_PATH=/models/smplx

# Тело по умолчанию, если пользователь не задал рост/вес
DEFAULT_HEIGHT_CM=175
DEFAULT_WEIGHT_KG=70

# Лимит загрузки файла, МБ
MAX_UPLOAD_MB=15

# Базовый публичный URL API (для presigned/локальных ссылок во фронтенде)
PUBLIC_API_BASE_URL=http://localhost:8000
