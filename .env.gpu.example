# ─────────────────────────────────────────────────────────────
# Окружение для GPU-машины (real-режим: SAM + InstantMesh + Blender).
# Скопируйте в .env на арендованном сервере:  cp .env.gpu.example .env
# и поправьте PUBLIC_API_BASE_URL (см. ниже).
# ─────────────────────────────────────────────────────────────
ENVIRONMENT=production

# Всё на одной GPU-машине: redis/db поднимает docker-compose рядом.
DATABASE_URL=postgresql+psycopg://tryon:tryon@db:5432/tryon
REDIS_URL=redis://redis:6379/0

# ── Real-режим + настоящая физика ткани ──
MOCK_PIPELINE=false
DRAPE_BACKEND=blender

# Тело: mpfb = реалистичный манекен MakeHuman (как на фото), параметр. по росту/весу.
# (образ должен быть собран с MPFB2 — в Dockerfile.worker.gpu включён по умолчанию)
BODY_ENGINE=mpfb
BODY_GENDER=male

# ── Хранилище ──
# Проще всего — локально на диске машины. Для прод-раздачи замените на S3/R2.
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_DIR=/data/storage

# ── Модели и пути (внутри GPU-образа) ──
MODELS_DIR=/models
HF_HOME=/models/hf
TORCH_HOME=/models/torch
SAM_CHECKPOINT=/models/sam_vit_h_4b8939.pth
SAM_MODEL_TYPE=vit_h
INSTANTMESH_REPO=/opt/InstantMesh
INSTANTMESH_CONFIG=/opt/InstantMesh/configs/instant-mesh-large.yaml
BLENDER_BIN=/opt/blender/blender

# Анатомическое тело SMPL-X (нужны лицензионные веса). false → параметрическое.
USE_SMPLX=false

# Тело по умолчанию
DEFAULT_HEIGHT_CM=175
DEFAULT_WEIGHT_KG=70

# ВАЖНО: замените на публичный IP арендованной машины (для ссылок и фронтенда).
# Узнать IP на самой машине:  curl -s ifconfig.me
PUBLIC_API_BASE_URL=http://CHANGE_ME_PUBLIC_IP:8000

# Прогреть веса InstantMesh при старте (первый job не ждёт скачивания)
PREWARM_INSTANTMESH=true
